			"name": "1. Autenticación",
			"description": "Endpoints de login y pruebas de autenticación",
			"item": [
				{
					"name": "1.1 Público (sin auth)",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/test/public",
						"description": "Endpoint público accesible sin autenticación"
					}
				},
				{
					"name": "1.2 Login USER",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"user\",\n    \"password\": \"password\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login",
						"description": "Login con usuario normal (ROLE_USER). Crea una sesión y devuelve el sessionId."
					}
				},
				{
					"name": "1.3 Login ADMIN",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login",
						"description": "Login con usuario administrador (ROLE_ADMIN)"
					}
				},
				{
					"name": "1.4 Endpoint Autenticado",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/test/authenticated",
						"description": "Requiere estar logueado. Devuelve 401 si no hay sesión."
					}
				},
				{
					"name": "1.5 Mi Info (/test/me)",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/test/me",
						"description": "Muestra username y roles del usuario autenticado"
					}
				},
				{
					"name": "1.6 Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/api/auth/logout",
						"description": "Cierra la sesión actual"
					}
				}
			]
		},
		{
			"name": "2. Gestión de Sesiones",
			"description": "Endpoints para ver y manipular la sesión HTTP",
			"item": [
				{
					"name": "2.1 Info Sesión",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/session/info",
						"description": "Muestra sessionId, username, roles, fechas de creación y último acceso"
					}
				},
				{
					"name": "2.2 Ver Atributos de Sesión",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/session/attributes",
						"description": "Lista todos los atributos almacenados en la sesión (incluyendo SecurityContext)"
					}
				},
				{
					"name": "2.3 Guardar Atributo",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/session/attribute?key=miDato&value=valorPrueba",
							"host": ["{{baseUrl}}"],
							"path": ["session", "attribute"],
							"query": [
								{"key": "key", "value": "miDato"},
								{"key": "value", "value": "valorPrueba"}
							]
						},
						"description": "Guarda un atributo personalizado en la sesión"
					}
				},
				{
					"name": "2.4 Obtener Atributo",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/session/attribute/miDato",
						"description": "Obtiene el valor de un atributo específico de la sesión"
					}
				},
				{
					"name": "2.5 Ver Timeout Sesión",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/session/timeout",
						"description": "Muestra el tiempo máximo de inactividad configurado"
					}
				},
				{
					"name": "2.6 Configurar Timeout (60 seg)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/session/timeout?segundos=60",
							"host": ["{{baseUrl}}"],
							"path": ["session", "timeout"],
							"query": [
								{"key": "segundos", "value": "60"}
							]
						},
						"description": "Configura el timeout de la sesión a 60 segundos"
					}
				},
				{
					"name": "2.7 Logout (Cerrar Sesión)",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/session/logout",
						"description": "Invalida la sesión y limpia el SecurityContext"
					}
				}
			]
		},
