    {
      "name": "🔐 Autenticación",
      "item": [
        {
          "name": "1. Login - Usuario Normal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Verificar que el login fue exitoso",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Login exitoso\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.mensaje).to.include(\"Login exitoso\");",
                  "    pm.expect(jsonData.usuario).to.eql(\"user\");",
                  "});",
                  "",
                  "pm.test(\"Cookie JSESSIONID presente\", function () {",
                  "    pm.expect(pm.cookies.has('JSESSIONID')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"user\",\n    \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login con usuario normal (user/password). Guarda la cookie JSESSIONID automáticamente."
          },
          "response": []
        },
