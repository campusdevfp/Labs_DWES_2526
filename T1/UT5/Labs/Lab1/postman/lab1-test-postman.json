          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204 or 404 or 409', function () { pm.expect(pm.response.code).to.be.oneOf([204, 404, 409]); });",
                  "pm.test('If 204 then no content', function () { if (pm.response.code === 204) pm.expect(pm.response.text()).to.eql(''); });"
                ]
              }
            }
          ]
        }
