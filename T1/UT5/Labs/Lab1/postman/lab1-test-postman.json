            "url": {
              "raw": "http://localhost:8080/api/clientes/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "clientes", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 404 or 400', function () { pm.expect(pm.response.code).to.be.oneOf([200, 404, 400]); });",
                  "pm.test('If 200 then returned object has id', function () { if (pm.response.code === 200) { var j = pm.response.json(); pm.expect(j).to.have.property('id'); } });"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar cliente",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "http://localhost:8080/api/clientes/3",
              "protocol": "http",
